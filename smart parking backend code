@RestController
@RequestMapping("/api")
@CrossOrigin(origins = "http://localhost:5173")
public class ParkingController {

    private final BookingService bookingService;

    public ParkingController(BookingService bookingService) {
        this.bookingService = bookingService;
    }

    @GetMapping("/slots/availability")
    public int availability() {
        return bookingService.availableSlots(12);
    }

    @PostMapping("/bookings")
    public CreateBookingResponse createBooking(
        @RequestBody CreateBookingRequest request
    ) {
        return bookingService.createBooking(request.getVehicleNumber());
    }

    @PostMapping("/bookings/{bookingId}/exit")
    public ExitBookingResponse exitParking(
        @PathVariable Long bookingId
    ) {
        return bookingService.exitBooking(bookingId);
    }
}

